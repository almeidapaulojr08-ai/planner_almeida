# Copie este arquivo para reports/.env e preencha. O .env NUNCA vai pro GitHub (está no .gitignore).
# Token do bot (o mesmo do @BotFather usado no relatório)
TELEGRAM_BOT_TOKEN=8123456789:AAH...
# Quem pode falar com o Salem: id:Nome separados por vírgula (Nome igual ao das transações)
TELEGRAM_CHAT_IDS=7266680194:Paulo,8733572876:Thayse
# Chave da Anthropic (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-...
# Banco
FIREBASE_DB_URL=https://almeida-wosniak-dre-default-rtdb.firebaseio.com
# Caminho do JSON da service account (Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada)
# Salve o arquivo dentro de reports/.secrets/ (pasta ignorada pelo git)
FIREBASE_SERVICE_ACCOUNT_FILE=.secrets/serviceAccount.json
# Opcional: claude-opus-5 (padrão) | claude-sonnet-5 | claude-haiku-4-5
SALEM_MODEL=claude-opus-5
